if(NOT DEFINED ARCHIVE_OUTPUT OR NOT DEFINED ARCHIVE_FORMAT OR NOT DEFINED ARCHIVE_COMPRESSION OR NOT DEFINED ARCHIVE_LEVEL)
    message(FATAL_ERROR "Archive settings are incomplete")
endif()

if(NOT DEFINED ARCHIVE_PATHS)
    file(GLOB ARCHIVE_PATHS RELATIVE "${CMAKE_CURRENT_BINARY_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/*")
endif()

if(NOT ARCHIVE_PATHS)
    message(FATAL_ERROR "The archive would be empty")
endif()

list(SORT ARCHIVE_PATHS)
file(ARCHIVE_CREATE
    OUTPUT "${ARCHIVE_OUTPUT}"
    PATHS ${ARCHIVE_PATHS}
    FORMAT "${ARCHIVE_FORMAT}"
    COMPRESSION "${ARCHIVE_COMPRESSION}"
    COMPRESSION_LEVEL "${ARCHIVE_LEVEL}"
)
