root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.{cpp,cxx,cc,h,hpp,hxx,inl}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{c,h}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{cmake,txt}]
indent_style = space
indent_size = 4
tab_width = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4
tab_width = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
